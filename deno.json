{
  "tasks": {
    "dev": "deno run -A --node-modules-dir npm:next dev",
    "build": "deno run -A scripts/buildWorker.ts",
    "deploy": "npx wrangler deploy",
    "start": "deno run -A --node-modules-dir npm:next start",
    "lint": "deno run -A --node-modules-dir npm:eslint",
    "test": "deno test -A --node-modules-dir"
  },
  "imports": {
    "@/": "./src/",
    "next/server": "./src/worker/nextServerShim.ts"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0,
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}


